#!/usr/bin/env bash
# validate-project-receipt — generate and validate a trusted receipt bound to project state.
# Subcommands:
#   generate [path] [learning-class]   -> writes a receipt, prints its path
#   validate <receipt-file>            -> exit 0 if still valid for current state, else non-zero
# A receipt binds to: project identity, root, redacted remote, branch, HEAD, tree checksum.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
WF_VERSION="$(cat "$HERE/../VERSION" 2>/dev/null || echo 0.0.0)"

state_json() {
  local target="$1"
  local info; info="$("$HERE/detect-project" "$target")"
  local root; root="$(printf '%s' "$info" | sed -E 's/.*"root":"([^"]+)".*/\1/')"
  local tree
  if (cd "$root" && git rev-parse HEAD >/dev/null 2>&1); then
    # bind to committed tree + staged/working diff so any change invalidates
    tree="$(cd "$root" && { git rev-parse HEAD; git diff; git diff --cached; git status --porcelain; } | sha256sum | cut -c1-16)"
  else
    tree="$(cd "$root" && find . -type f -not -path './.git/*' -exec sha256sum {} \; 2>/dev/null | sort | sha256sum | cut -c1-16)"
  fi
  # emit info with tree checksum appended
  printf '%s' "$info" | sed -E "s/\}$/,\"tree_checksum\":\"$tree\"}/"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  generate)
    target="${1:-$PWD}"; klass="${2:-NO_NEW_LEARNING}"
    rtdir="$("$HERE/project-runtime-path" "$target")"
    st="$(state_json "$target")"
    id="$(printf '%s' "$st" | sed -E 's/.*"identity":"([^"]+)".*/\1/')"
    ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    stamp="$(date -u +%Y%m%dT%H%M%SZ)"
    out="$rtdir/receipts/receipt-$stamp.json"
    body="$(printf '%s' "$st" | sed -E "s/\}$/,\"learning_class\":\"$klass\",\"workflow_version\":\"$WF_VERSION\",\"generated_at\":\"$ts\"}/")"
    printf '%s\n' "$body" > "$out"
    chmod 600 "$out" 2>/dev/null || true
    echo "$out"
    ;;
  validate)
    rf="${1:?receipt file required}"
    [ -f "$rf" ] || { echo "FAIL: receipt missing"; exit 3; }
    r_id="$(sed -E 's/.*"identity":"([^"]+)".*/\1/' "$rf")"
    r_root="$(sed -E 's/.*"root":"([^"]+)".*/\1/' "$rf")"
    r_tree="$(sed -E 's/.*"tree_checksum":"([^"]+)".*/\1/' "$rf")"
    cur="$(state_json "$r_root")"
    c_id="$(printf '%s' "$cur" | sed -E 's/.*"identity":"([^"]+)".*/\1/')"
    c_tree="$(printf '%s' "$cur" | sed -E 's/.*"tree_checksum":"([^"]+)".*/\1/')"
    if [ "$r_id" != "$c_id" ]; then echo "REJECT: project/identity mismatch"; exit 4; fi
    if [ "$r_tree" != "$c_tree" ]; then echo "REJECT: tree changed since receipt generation"; exit 5; fi
    echo "VALID"
    ;;
  *)
    echo "usage: validate-project-receipt {generate [path] [class] | validate <file>}" >&2
    exit 2
    ;;
esac
