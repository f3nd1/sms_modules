 "content": "[{\"id\":\"kq5R-XefvN\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h1\\\">Quality Module</span>\",\"col\":12}},{\"id\":\"P_oE2HYGmO\",\"type\":\"paragraph\",\"data\":{\"text\":\"The Quality Module in ERPNext is an essential tool for managing and enhancing organizational quality standards. Operating at an&nbsp;<b>operational level</b>, it provides comprehensive functionalities for setting <b>quality goals, overseeing procedures, and ensuring regulatory compliance</b>. This module is crucial for operational managers and quality assurance teams focused on maintaining consistent quality control, facilitating detailed inspections, and generating actionable feedback and reports.  For more information please visit: <a href=\\\"https://shorturl.at/BIRUW\\\">Quality Module - Wiki</a>\",\"col\":12}},{\"id\":\"JvGFt3mZyP\",\"type\":\"custom_block\",\"data\":{\"custom_block_name\":\"Horizontal Rule\",\"col\":12}},{\"id\":\"8b_EDMkafS\",\"type\":\"header\",\"data\":{\"text\":\"<span class=\\\"h4\\\"><b>Your Shortcuts</b></span>\",\"col\":12}},{\"id\":\"aToJJ-oneU\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Quality Dashboard\",\"col\":3}},{\"id\":\"WgGLzLiYJJ\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Quality Goal\",\"col\":3}},{\"id\":\"fNXo8P_Kyr\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Quality Action\",\"col\":3}},{\"id\":\"cGJufyM2DL\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Quality Procedure\",\"col\":3}},{\"id\":\"bZOJcWb2B1\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Quality Inspection\",\"col\":3}},{\"id\":\"b0l2P5S1KN\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Quality Meeting\",\"col\":3}},{\"id\":\"Y-OZfI-zJl\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Compliance Tracking\",\"col\":3}},{\"id\":\"uQfIEyAYO1\",\"type\":\"shortcut\",\"data\":{\"shortcut_name\":\"Quality Review\",\"col\":3}},{\"id\":\"ttrZowfWPc\",\"type\":\"custom_block\",\"data\":{\"custom_block_name\":